# 복사해서 .env 로 쓰고, 실제 키는 절대 커밋하지 않는다 (인계서 9.3)
DATABASE_URL=postgresql://worksense:worksense@localhost:5432/worksense
STORAGE_DIR=./storage

# Gemini API (유료 환경 키만 사용, 인계서 9.1)
GEMINI_API_KEY=
GEMINI_MODEL_VIDEO=gemini-3.8-flash
GEMINI_MODEL_TRANSCRIBE=gemini-3.5-transcribe
GEMINI_MODEL_TEXT=gemini-3.5-flash-lite
GEMINI_MODEL_EMBED=gemini-embedding-2
EMBED_DIM=1536

# 공공데이터포털 (NCS 15157547, 장애인 고용직무분류 15157071, 복지 15090532/15108347)
DATA_GO_KR_KEY=
# 국립국어원 한국어기초사전 오픈 API
KRDICT_KEY=

# RAG
RAG_TOP_K=3
RAG_MIN_SIMILARITY=0.6
REPEAT_QUESTION_SIMILARITY=0.85

# 프론트엔드 → 백엔드
NEXT_PUBLIC_API_BASE=http://localhost:8000
